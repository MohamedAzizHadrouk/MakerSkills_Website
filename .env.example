# =============================================================================
# Maker Skills – production environment template
# Copy to .env on the VPS at /home/ubuntu/makerskills/.env
# NEVER commit the real .env file.
# =============================================================================

# --- Compose / runtime ---
COMPOSE_PROJECT_NAME=makerskills
NODE_ENV=production

# Backend
PORT=3020
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority&appName=makerskills
JWT_SECRET=change-me-to-a-long-random-secret
CORS_ORIGINS=https://www.makerskills.tn,https://makerskills.tn
SITE_URL=https://www.makerskills.tn
UPLOADS_DIR=/app/uploads

# Frontend (baked at Docker image build time)
# Empty string = same-origin (API proxied by frontend Nginx)
VITE_API_URL=

# Host publish (frontend only; must not clash with RondeGuard ports)
FRONTEND_HOST_PORT=3100
